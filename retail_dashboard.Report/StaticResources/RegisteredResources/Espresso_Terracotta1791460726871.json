{
  "name": "Espresso Terracotta",
  "dataColors": [
    "#5D3F37",
    "#D4654A",
    "#C49A6C",
    "#A4857B",
    "#CCCCCC",
    "#8B6356",
    "#3B2820",
    "#E3C7B3",
    "#7A6A64",
    "#EB895F"
  ],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "foregroundNeutralSecondary": "#858482",
  "backgroundLight": "#F6F5F3",
  "backgroundNeutral": "#E6E1DC",
  "tableAccent": "#5D3F37",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F6F5F3"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F0E8E0"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#3B2820"
              }
            },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#858482"
              }
            },
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#B2B1B0"
              }
            },
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#605E5C"
              }
            },
            "legendMarkerRendering": "markerCircleDefault"
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "color": {
              "solid": {
                "color": "#605E5C"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 20,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#252423"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "color": {
              "solid": {
                "color": "#858482"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEEAE6"
              }
            },
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#E6E1DC"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#605E5C"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#252423"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#252423"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "total": [
          {
            "fontFamily": "Segoe UI Bold",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#252423"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "layout": [
          {
            "orientation": 1,
            "cellPadding": 8
          }
        ],
        "shape": [
          {
            "tileShape": "rectangleRounded",
            "rectangleRoundedCurve": 8
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#483428"
              }
            },
            "transparency": 0
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#5A4236"
              }
            },
            "transparency": 0
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#EB895F"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#6B5448"
              }
            },
            "weight": 1,
            "transparency": 0
          },
          {
            "$id": "selected",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#EB895F"
              }
            },
            "weight": 1,
            "transparency": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#D9CFC8"
              }
            },
            "horizontalAlignment": "center",
            "verticalAlignment": "middle"
          },
          {
            "$id": "selected",
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    }
  }
}