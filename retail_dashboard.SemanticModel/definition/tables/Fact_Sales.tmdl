table Fact_Sales
	lineageTag: affcd953-7eaa-4ef2-838e-365d4786e082

	measure 'Net Sales' = SUM( Fact_Sales[Net_Sales] )
		formatString: #,0
		lineageTag: c73ba679-30e9-4a5a-800f-ba2b5803933e

	measure 'Last Data Date' = MAX( Fact_Sales[Order_Date] )
		formatString: dd mmm yyyy
		lineageTag: 20c55e4c-ba1b-4982-9391-4c3eb2c1bc17

	measure 'Net Sales PM' = CALCULATE( [Net Sales], DATEADD( Dim_Date[Date], -1, MONTH ) )
		formatString: #,0
		lineageTag: af39fa30-e622-4c66-b8e5-c7090797ce1d

	measure 'Net Sales MoM Δ' = IF( NOT ISBLANK( [Net Sales PM] ), [Net Sales] - [Net Sales PM] )
		formatString: #,0
		lineageTag: 225fb206-2d3d-4eeb-8f85-9441cdc8fd6a

	measure 'Net Sales MoM %' = DIVIDE( [Net Sales MoM Δ], [Net Sales PM] )
		formatString: 0.00%
		lineageTag: 75251c90-0285-4a21-a09b-2772e966e9f6

	measure 'True Discount Given' =
			CALCULATE( SUMX( Fact_Sales, Fact_Sales[Gross_Sales] * Fact_Sales[Discount_Pct] ),
			           Fact_Sales[Order_Status] = "Completed" )
		formatString: #,0
		lineageTag: d020befc-bbba-4129-8453-b625b716962a

	measure 'Gross Sales (Completed)' = CALCULATE( SUM( Fact_Sales[Gross_Sales] ), Fact_Sales[Order_Status] = "Completed" )
		formatString: #,0
		lineageTag: e456001a-4ef8-464f-b4d3-63609d5d6adf

	measure 'Discount Rate %' = DIVIDE( [True Discount Given], [Gross Sales (Completed)] )
		formatString: 0.00%
		lineageTag: 5db9dac7-53f7-46f7-82d7-0cb48b2ab97c

	measure 'Gross Profit' =
			CALCULATE( SUM( Fact_Sales[Gross_Profit] ),
			           KEEPFILTERS( Fact_Sales[Order_Status] = "Completed" ) )
		formatString: #,0
		lineageTag: 496562ea-a63a-4ce6-96c2-4b74adf60617

	measure 'Gross Margin %' = DIVIDE( [Gross Profit], [Net Sales] )
		formatString: 0.00%
		lineageTag: 66f80b64-981c-4bd1-a077-7fd6da1e5d7b

	measure 'Units per Line' =
			DIVIDE(
			  CALCULATE( SUM( Fact_Sales[Quantity] ), Fact_Sales[Order_Status]="Completed" ),
			  CALCULATE( COUNTROWS( Fact_Sales ),      Fact_Sales[Order_Status]="Completed" ) )
		formatString: 0.00
		lineageTag: 6549a655-ec86-41ec-96c0-8e34c69402ae

	measure 'Buying Customers' =
			CALCULATE( DISTINCTCOUNT( Fact_Sales[Customer_ID] ),
			           Fact_Sales[Order_Status] = "Completed",
			           Dim_Customer[Customer_ID] <> "Unknown" )
		formatString: #,0
		lineageTag: 03de6165-18bd-4b0e-8cae-0ed604e9101c

	measure 'Net Sales (known cust)' = CALCULATE( [Net Sales], Dim_Customer[Customer_ID] <> "Unknown" )
		formatString: #,0
		lineageTag: cf9d2802-9ae8-4a1a-831c-a1ff94591481

	measure 'Net per Buying Customer' = DIVIDE( [Net Sales (known cust)], [Buying Customers] )
		formatString: #,0
		lineageTag: 699772a1-24db-4802-aacb-90475db3cf46

	measure 'Returned Lines' = CALCULATE( COUNTROWS( Fact_Sales ), Fact_Sales[Order_Status] = "Returned" )
		formatString: #,0
		lineageTag: 5a10fda0-7942-4574-874e-0460a1feea46

	measure 'Return Rate %' = DIVIDE( [Returned Lines], COUNTROWS( Fact_Sales ) )
		formatString: 0.00%
		lineageTag: a7bd9454-f14c-4000-ac0a-bfa138f54eb7

	measure 'Forgone Net Sales' =
			CALCULATE( SUMX( Fact_Sales, Fact_Sales[Gross_Sales] * ( 1 - Fact_Sales[Discount_Pct] ) ),
			           Fact_Sales[Order_Status] IN { "Returned", "Cancelled" } )
		formatString: #,0
		lineageTag: 6d8debf0-771e-4b2b-b006-ba3718eac580

	measure 'Potential Net Sales' = [Net Sales] + [Forgone Net Sales]
		formatString: #,0
		lineageTag: 738a364a-5bf5-4f01-b911-5f6deb0b0708

	measure 'Forgone % of Potential' = DIVIDE( [Forgone Net Sales], [Potential Net Sales] )
		formatString: 0.00%
		lineageTag: b3ddab48-20a7-4959-803d-a0ff86fa809e

	measure 'Return Handling Cost' = CALCULATE( SUM( Fact_Sales[Gross_Profit] ), Fact_Sales[Order_Status] = "Returned" )
		formatString: #,0
		lineageTag: 468b053b-670e-4efd-8a93-c270bb04089c

	measure 'Completed Orders' =
			CALCULATE( DISTINCTCOUNT( Fact_Sales[Order_ID] ),
			           Fact_Sales[Order_Status] = "Completed" )
		formatString: #,0
		lineageTag: d36e2eaf-821d-4c41-9cb2-f4e3f6c467d6

	measure AOV = DIVIDE( [Net Sales], [Completed Orders] )
		formatString: #,0
		lineageTag: 38e2de66-9add-403a-ada2-f083626cc3ed

	measure 'Net Sales Share %' =
			DIVIDE( [Net Sales],
			        CALCULATE( [Net Sales], REMOVEFILTERS( Dim_Channel ) ) )
		formatString: 0.00%
		lineageTag: deefe4af-55ec-4b3b-ba07-ba02cc29510f

	measure 'Delivered Lines' =
			CALCULATE( COUNTROWS( Fact_Sales ),
			           KEEPFILTERS( Fact_Sales[Order_Status] <> "Cancelled" ),
			           KEEPFILTERS( NOT ISBLANK( Fact_Sales[Days_Late] ) ) )
		formatString: #,0
		lineageTag: 11285a33-2cf4-4b19-8774-0cae310f5704

	measure 'On-Time Rate %' =
			DIVIDE( CALCULATE( [Delivered Lines], KEEPFILTERS( Fact_Sales[Days_Late] = 0 ) ),
			        [Delivered Lines] )
		formatString: 0.00%
		lineageTag: 0df572ae-27b9-4c45-8167-925e8da1c9bb

	measure 'Rated Lines' = COUNT( Fact_Sales[Customer_Rating] )
		formatString: #,0
		lineageTag: 3767f93f-6191-43ae-8ec7-2c53ebf2b380

	measure 'Avg Rating' = AVERAGE( Fact_Sales[Customer_Rating] )
		formatString: 0.00
		lineageTag: 207a2ecc-d2d5-4812-abd1-69fb3699cb2c

	measure 'Avg Rating (Completed)' = CALCULATE( [Avg Rating], KEEPFILTERS( Fact_Sales[Order_Status] = "Completed" ) )
		formatString: 0.00
		lineageTag: 1b0de0bc-a285-4a7d-8721-42e7ffbff8fd

	measure 'Rated Lines (Completed)' =
			CALCULATE( COUNT( Fact_Sales[Customer_Rating] ),
			           KEEPFILTERS( Fact_Sales[Order_Status] = "Completed" ) )
		formatString: #,0
		lineageTag: c8fd62d6-f280-439e-ba64-990b2b91590f

	measure 'Completed Lines' = CALCULATE( COUNTROWS( Fact_Sales ), KEEPFILTERS( Fact_Sales[Order_Status] = "Completed" ) )
		formatString: #,0
		lineageTag: bcd655d2-f026-43c9-8bd8-e9a1336afe29

	measure 'Rating Response Rate % (Completed)' = DIVIDE( [Rated Lines (Completed)], [Completed Lines] )
		formatString: 0.00%
		lineageTag: c865ca16-c246-4b0b-9226-5b9a7610d1ee

	measure 'Rating Response Rate %' = DIVIDE( [Rated Lines], COUNTROWS( Fact_Sales ) )
		formatString: 0.00%
		lineageTag: 9928477c-b8e7-4303-99c8-855210d77b48

