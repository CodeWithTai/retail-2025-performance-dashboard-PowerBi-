	partition Fact_Sales = m
		mode: import
		source = let Source = Excel.Workbook(File.Contents("C:\\AI-Agent-Team\\retail_sales_2025.xlsx"), null, true), SalesTable = Source{[Item="SalesTable",Kind="Table"]}[Data], RemovedMargin = Table.RemoveColumns(SalesTable, {"Profit_Margin"}), FixCustNull = Table.ReplaceValue(RemovedMargin, null, "Unknown", Replacer.ReplaceValue, {"Customer_ID"}), FixCustBlank = Table.ReplaceValue(FixCustNull, "", "Unknown", Replacer.ReplaceValue, {"Customer_ID"}), FixPromoNull = Table.ReplaceValue(FixCustBlank, null, "No promo", Replacer.ReplaceValue, {"Promo_Code"}), FixPromoBlank = Table.ReplaceValue(FixPromoNull, "", "No promo", Replacer.ReplaceValue, {"Promo_Code"}), FixDeliveryDaysBlank = Table.ReplaceValue(FixPromoBlank, "", null, Replacer.ReplaceValue, {"Delivery_Days"}), ChangedType = Table.TransformColumnTypes(FixDeliveryDaysBlank, {{"Transaction_ID", type text}, {"Order_ID", type text}, {"Order_Date", type date}, {"Sales_Channel", type text}, {"Campaign", type text}, {"Store_or_Fulfillment", type text}, {"City", type text}, {"Region", type text}, {"Customer_ID", type text}, {"Product_ID", type text}, {"Quantity", Int64.Type}, {"Unit_Price", type number}, {"Discount_Pct", type number}, {"Unit_Cost", type number}, {"Gross_Sales", type number}, {"Net_Sales", type number}, {"Gross_Profit", type number}, {"Order_Status", type text}, {"Payment_Method", type text}, {"Promo_Code", type text}, {"Delivery_Type", type text}, {"Promised_Date", type date}, {"Delivered_Date", type date}, {"Delivery_Days", Int64.Type}, {"Customer_Rating", Int64.Type}}), RenamedDaysLate = Table.RenameColumns(ChangedType, {{"Delivery_Days", "Days_Late"}}), AddKey = Table.AddColumn(RenamedDaysLate, "Channel_Campaign_Key", each [Sales_Channel] & "|" & [Campaign], type text) in AddKey

